rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /store_content/{document=**} {
      allow read, write: if true;
    }

    match /products/{productId} {
      allow read, write: if true;
    }

    match /admin_users/{userId} {
      allow read, write: if true;
    }

    match /access_requests/{requestId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}
